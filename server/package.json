{
  "name": "@constructelligence/revit-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "MCP server that connects AI clients to Autodesk Revit through the revit-mcp add-in",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "mock": "node server.mjs --mock",
    "test": "node --test",
    "tools:table": "node tools-table.mjs",
    "demo": "node demo.mjs",
    "check:docs": "node check-docs.mjs",
    "prepublishOnly": "npm test && npm run check:docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "revit",
    "bim",
    "autodesk",
    "ai",
    "construction",
    "claude"
  ],
  "homepage": "https://github.com/constructelligence-lab/revit-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constructelligence-lab/revit-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/constructelligence-lab/revit-mcp/issues"
  },
  "bin": {
    "revit-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "bridge.mjs",
    "camera.mjs",
    "blender.mjs",
    "blender/render.py",
    "tools.mjs",
    "prompts.mjs",
    "resources.mjs",
    "mock.mjs",
    "demo.mjs",
    "check-docs.mjs",
    "tools-table.mjs",
    "README.md"
  ]
}
